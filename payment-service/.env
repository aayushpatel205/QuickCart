# .env – local development overrides (NOT committed to git)
# These are only used when running WITHOUT Docker Compose (i.e., bare uvicorn locally)

DB_HOST=localhost
DB_PORT=5433
DB_NAME=paymentdb
DB_USER=payment_user
DB_PASSWORD=payment_pass

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=payment-service
KAFKA_TOPIC_ORDER_CREATED=order.created
KAFKA_TOPIC_PAYMENT_COMPLETED=payment.completed
KAFKA_TOPIC_PAYMENT_FAILED=payment.failed

PAYMENT_SUCCESS_THRESHOLD_AMOUNT=5000
PAYMENT_RANDOM_FAIL_PERCENT=10
CB_FAIL_MAX=5
CB_RESET_TIMEOUT=60

APP_ENV=development
LOG_LEVEL=INFO
