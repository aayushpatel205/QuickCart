{
  "name": "quickcart-restaurant-service",
  "version": "1.0.0",
  "description": "QuickCart Restaurant Service (Node.js/Express + gRPC + MongoDB) and Kong API Gateway",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/service.test.js && node test/routes.test.js",
    "seed": "node src/db/seed.js",
    "test-grpc": "node scripts/test-grpc-client.js",
    "token:admin": "node scripts/generate-token.js --role ADMIN",
    "token:customer": "node scripts/generate-token.js --role CUSTOMER"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.9",
    "@grpc/proto-loader": "^0.7.13",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "opossum": "^8.1.4",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
