# ──────────────────────────────────────────────
# QuickCart - Cart & Notification Service (.env)
# ──────────────────────────────────────────────
# Replace the IP addresses below with the actual
# IPs shared by your teammates in the group chat.
# ──────────────────────────────────────────────

# 🔴 Redis (Infra person's IP)
Redis__ConnectionString=192.168.1.XX:6379

# 🔴 Kafka (Infra person's IP)
Kafka__BootstrapServers=192.168.1.XX:9092

# 🔴 RabbitMQ (Infra person's IP)
RabbitMQ__Host=192.168.1.XX
RabbitMQ__Port=5672
RabbitMQ__Username=guest
RabbitMQ__Password=guest

# 🔴 Order Service (Teammate running order-service IP)
OrderService__BaseUrl=http://192.168.1.XX:8081
